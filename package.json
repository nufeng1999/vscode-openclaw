{
	"name": "nufeng-OpenClaw-vscode",
	"displayName": "nufeng-OpenClaw Client",
	"description": "%extension.description%",
	"version": "0.0.24",
	"publisher": "CQCBIT",
	"icon": "plugin.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/nufeng/openclaw-vscode"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Chat",
		"Other"
	],
	"keywords": [
		"openclaw",
		"ai",
		"chat",
		"llm",
		"agent"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"contributes": {
		"commands": [
			{
				"command": "openclaw.openChat",
				"title": "OpenClaw: Open Chat"
			},
			{
				"command": "openclaw.reconnect",
				"title": "OpenClaw: Reconnect"
			},
			{
				"command": "openclaw.approvePairing",
				"title": "OpenClaw: Approve Node Pairing"
			},
			{
				"command": "openclaw.newChat",
				"title": "OpenClaw: New Chat"
			},
			{
				"command": "openclaw.settings",
				"title": "OpenClaw: Settings"
			},
			{
				"command": "openclaw.resetDevice",
				"title": "OpenClaw: Reset Device Identity"
			},
			{
				"command": "openclaw.switchWorkdir",
				"title": "%switchWorkdir.title%"
			},
			{
				"command": "openclaw.setInputText",
				"title": "OpenClaw: Set Input Text"
			},
			{
				"command": "openclaw.analyzeProject",
				"title": "%analyzeProject.title%"
			}
		],
		"submenus": [
			{
				"id": "openclaw.contextMenu",
				"label": "OpenClaw VSCode"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "openclaw-sidebar",
					"title": "OpenClaw",
					"icon": "$(comment-discussion)"
				}
			]
		},
		"views": {
			"openclaw-sidebar": [
				{
					"type": "webview",
					"id": "openclaw.chatView",
					"name": "OpenClaw Chat"
				}
			]
		},
		"menus": {
			"explorer/context": [
				{
					"submenu": "openclaw.contextMenu",
					"when": "explorerResourceIsFolder",
					"group": "OpenClaw@1"
				}
			],
			"openclaw.contextMenu": [
				{
					"command": "openclaw.switchWorkdir",
					"when": "explorerResourceIsFolder",
					"group": "navigation@1"
				},
				{
					"command": "openclaw.analyzeProject",
					"when": "explorerResourceIsFolder",
					"group": "navigation@2"
				}
			]
		},
		"configuration": {
			"title": "OpenClaw",
			"properties": {
				"openclaw.gatewayUrl": {
					"type": "string",
					"default": "ws://127.0.0.1:18789",
					"description": "%config.gatewayUrl.description%"
				},
				"openclaw.token": {
					"type": "string",
					"default": "",
					"description": "%config.token.description%"
				},
				"openclaw.sessionKey": {
					"type": "string",
					"default": "OpenClaw VSCode",
					"description": "%config.sessionKey.description%"
				},
				"openclaw.agentId": {
					"type": "string",
					"default": "OpenClaw VSCode",
					"description": "%config.agentId.description%"
				},
				"openclaw.supervisor.intervalMinutes": {
					"type": "number",
					"default": 5,
					"minimum": 0,
					"description": "%config.supervisor.intervalMinutes.description%"
				},
				"openclaw.supervisor.stopSignalContent": {
					"type": "string",
					"default": "",
					"description": "%config.supervisor.stopSignalContent.description%"
				},
				"openclaw.supervisor.reminderMessage": {
					"type": "string",
					"default": "",
					"description": "%config.supervisor.reminderMessage.description%"
				},
				"openclaw.supervisor.agentId": {
					"type": "string",
					"default": "",
					"description": "%config.supervisor.agentId.description%"
				},
				"openclaw.supervisor.stopInquiryMethod": {
					"type": "string",
					"default": "",
					"description": "%config.supervisor.stopInquiryMethod.description%"
				},
				"openclaw.supervisor.stopSignalReply": {
					"type": "string",
					"default": "yes",
					"description": "%config.supervisor.stopSignalReply.description%"
				}
			}
		}
	},
	"scripts": {
		"build": "node esbuild.mjs",
		"watch": "node esbuild.mjs --watch"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/ws": "^8.5.10",
		"@types/vscode": "^1.80.0",
		"esbuild": "^0.20.0",
		"typescript": "^5.3.0"
	},
	"dependencies": {
		"ws": "^8.16.0"
	},
	"__metadata": {
		"installedTimestamp": 1787300215281,
		"targetPlatform": "undefined",
		"size": 2156299
	}
}
