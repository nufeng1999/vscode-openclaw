{
  "name": "openclaw-vscode",
  "displayName": "OpenClaw",
  "description": "AI chat sidebar for OpenClaw gateway",
  "version": "0.0.1",
  "publisher": "nufeng",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openclaw.openChat",
        "title": "OpenClaw: Open Chat"
      },
      {
        "command": "openclaw.reconnect",
        "title": "OpenClaw: Reconnect"
      },
      {
        "command": "openclaw.newChat",
        "title": "OpenClaw: New Chat"
      },
      {
        "command": "openclaw.settings",
        "title": "OpenClaw: Settings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openclaw-sidebar",
          "title": "OpenClaw",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "openclaw-sidebar": [
        {
          "type": "webview",
          "id": "openclaw.chatView",
          "name": "OpenClaw Chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenClaw",
      "properties": {
        "openclaw.gatewayUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:18789",
          "description": "WebSocket URL of the OpenClaw gateway"
        },
        "openclaw.token": {
          "type": "string",
          "default": "",
          "description": "Auth token for the gateway"
        },
        "openclaw.sessionKey": {
          "type": "string",
          "default": "main",
          "description": "Session key"
        },
        "openclaw.agentId": {
          "type": "string",
          "default": "main",
          "description": "Agent ID"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
